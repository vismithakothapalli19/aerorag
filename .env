# Server configuration
HOST=127.0.0.1
PORT=8000

# API Keys
# Required if using OpenAI providers
OPENAI_API_KEY=your_openai_api_key_here

# Embeddings Configuration
# Options: openai, huggingface
EMBEDDING_PROVIDER=openai
# For openai: text-embedding-3-small, text-embedding-ada-002
# For huggingface: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=text-embedding-3-small

# LLM Configuration
# Options: openai, ollama
LLM_PROVIDER=openai
# For openai: gpt-4o-mini, gpt-4o, etc.
# For ollama: llama3, mistral, etc.
LLM_MODEL=gpt-4o-mini

# Ollama settings (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Vector DB settings
CHROMA_DB_DIR=./chroma_db
CHROMA_COLLECTION_NAME=document_qa_collection

# Ingestion configuration
MAX_UPLOAD_SIZE_MB=10
